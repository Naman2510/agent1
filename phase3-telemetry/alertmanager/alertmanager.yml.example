# Phase 3 — Alertmanager routing.
# Install to: /etc/alertmanager/alertmanager.yml

route:
  receiver: default-webhook
  group_by: ["alertname", "disk", "zone"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - match:
        severity: critical
      receiver: pagerduty-critical
      repeat_interval: 30m

receivers:
  - name: default-webhook
    slack_configs:
      - api_url: "https://hooks.slack.com/services/REPLACE/ME/WITH_YOUR_WEBHOOK"
        channel: "#edge-server-alerts"
        send_resolved: true

  - name: pagerduty-critical
    pagerduty_configs:
      - routing_key: "REPLACE_WITH_PAGERDUTY_INTEGRATION_KEY"
        send_resolved: true
