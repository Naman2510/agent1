# Copy to .env and fill in. Values here are placeholders and MUST NOT be used as-is.
# .env is git-ignored; no real secret belongs in this file or in the repository.

VAANIOS_ENVIRONMENT=development
VAANIOS_DEBUG=false

# --- Stores -----------------------------------------------------------------
VAANIOS_DATABASE_URL=postgresql+asyncpg://vaanios:vaanios@localhost:5432/vaanios
VAANIOS_REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=change-me-locally

# --- Auth -------------------------------------------------------------------
# At least 32 characters. Generate one with:  openssl rand -base64 48
VAANIOS_JWT_SECRET=
VAANIOS_ACCESS_TOKEN_TTL_SECONDS=900
VAANIOS_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Rate limiting (SECURITY.md §4) -----------------------------------------
VAANIOS_RATE_LIMIT_ENABLED=true
VAANIOS_RATE_LIMIT_ANONYMOUS_PER_MIN=10
VAANIOS_RATE_LIMIT_AUTHENTICATED_PER_MIN=60
VAANIOS_RATE_LIMIT_AI_PER_MIN=6
VAANIOS_RATE_LIMIT_VOICE_MINUTES_PER_DAY=60

# --- Cost guard -------------------------------------------------------------
# Leave unset to enforce no ceiling. The application logs a warning at startup when it is unset,
# so an absent cap is visible rather than assumed (Gate 0 finding M-11).
VAANIOS_MONTHLY_SPEND_CAP_USD=

# --- HTTP / logging ---------------------------------------------------------
VAANIOS_CORS_ORIGINS=http://localhost:3000
VAANIOS_LOG_LEVEL=INFO
VAANIOS_LOG_JSON=true
# Logs full student speech. Development only; refused in production.
VAANIOS_LOG_TRANSCRIPTS=false

# --- Tests ------------------------------------------------------------------
VAANIOS_TEST_DATABASE_URL=postgresql+asyncpg://vaanios:vaanios@localhost:5432/vaanios_test

# --- Model providers (Phase 2; unused in Phase 1) ---------------------------
# ANTHROPIC_API_KEY=
