# Copy to .env and fill in. Values here are placeholders and MUST NOT be used as-is.
# .env is git-ignored; no real secret belongs in this file or in the repository.

VAANIOS_ENVIRONMENT=development
VAANIOS_DEBUG=false

# --- Stores -----------------------------------------------------------------
VAANIOS_DATABASE_URL=postgresql+asyncpg://vaanios:vaanios@localhost:5432/vaanios
VAANIOS_REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=change-me-locally

# --- Auth -------------------------------------------------------------------
# At least 32 characters. Generate one with:  openssl rand -base64 48
VAANIOS_JWT_SECRET=
VAANIOS_ACCESS_TOKEN_TTL_SECONDS=900
VAANIOS_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Rate limiting (SECURITY.md §4) -----------------------------------------
VAANIOS_RATE_LIMIT_ENABLED=true
VAANIOS_RATE_LIMIT_ANONYMOUS_PER_MIN=10
VAANIOS_RATE_LIMIT_REFRESH_PER_MIN=60
VAANIOS_RATE_LIMIT_AUTHENTICATED_PER_MIN=60
VAANIOS_RATE_LIMIT_AI_PER_MIN=6
VAANIOS_RATE_LIMIT_VOICE_MINUTES_PER_DAY=60

# --- Model providers (ADR-0016) ---------------------------------------------
# Selection is config, so comparing models is an experiment rather than a rewrite.
# "fake" is the deterministic double: no network, no cost. Use it for local work without a key.
VAANIOS_LLM_PROVIDER=anthropic
VAANIOS_LLM_MODEL=claude-opus-5
# Latency/quality dial, not a model downgrade. Starting point pending EXP-004.
VAANIOS_LLM_EFFORT=medium
VAANIOS_LLM_MAX_OUTPUT_TOKENS=1024
VAANIOS_LLM_TIMEOUT_SECONDS=30
# Server-side rescue if a request is declined on policy grounds. Empty disables it.
VAANIOS_LLM_REFUSAL_FALLBACK_MODEL=claude-opus-4-8
# Turns of history resent each request. Every token resent costs money and latency.
VAANIOS_LLM_HISTORY_TURNS=20

# --- Voice (ADR-0001, ADR-0004) ---------------------------------------------
# Speech in and out. "fake" hears a scripted transcript and speaks silence. The real ones are local
# and for development, and the production image has neither: espeak (ADR-0018; the espeak-ng
# program, or infra/compose.local-voice.yaml) and faster-whisper (the voice-local extra).
VAANIOS_TTS_PROVIDER=fake
VAANIOS_STT_PROVIDER=fake
VAANIOS_VAD_PROVIDER=silero
VAANIOS_SILERO_VAD_PATH=models/silero_vad.onnx
# Library defaults, NOT tuned against real speech (no human-speech fixture exists yet).
VAANIOS_VAD_ENTER_THRESHOLD=0.5
VAANIOS_VAD_EXIT_THRESHOLD=0.35
VAANIOS_VAD_MIN_SPEECH_MS=250
VAANIOS_VAD_MIN_SILENCE_MS=500
# Rolling audio kept so an interrupting utterance keeps its first word.
VAANIOS_VOICE_PRE_ROLL_MS=500

# --- Cost guard -------------------------------------------------------------
# Leave unset to enforce no ceiling. The application logs a warning at startup when it is unset,
# so an absent cap is visible rather than assumed (Gate 0 finding M-11).
VAANIOS_MONTHLY_SPEND_CAP_USD=

# --- Frontend (frontend/, infra/docker/frontend.Dockerfile) --------------------
# Where the browser reaches the backend. Baked into the bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the frontend's auth proxy reaches it (server side; defaults to NEXT_PUBLIC_API_URL).
VAANIOS_API_URL=http://localhost:8000

# --- HTTP / logging ---------------------------------------------------------
VAANIOS_CORS_ORIGINS=http://localhost:3000
VAANIOS_LOG_LEVEL=INFO
VAANIOS_LOG_JSON=true
# Logs full student speech. Development only; refused in production.
VAANIOS_LOG_TRANSCRIPTS=false
# Traces: none (the default), console, or otlp — sent to any OpenTelemetry collector, e.g. a
# Jaeger or Tempo instance's OTLP/HTTP endpoint. Spans never carry what the student said.
VAANIOS_OTEL_EXPORTER=none
VAANIOS_OTEL_ENDPOINT=http://localhost:4318/v1/traces

# --- Tests ------------------------------------------------------------------
VAANIOS_TEST_DATABASE_URL=postgresql+asyncpg://vaanios:vaanios@localhost:5432/vaanios_test

# --- Provider credentials ---------------------------------------------------
# Read by the Anthropic SDK. `ant auth login` works too — the SDK reads the stored profile,
# so this does not have to be set at all.
# ANTHROPIC_API_KEY=
