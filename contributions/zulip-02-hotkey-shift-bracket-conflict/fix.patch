+class DeleteUserAvatarTest(UploadSerializeMixin, ZulipTestCase):
+    def test_do_delete_user_scrubs_avatar_images(self) -> None:
+        """
+        do_delete_user_core resets the UserProfile's avatar fields back
+        to their defaults, but that alone leaves the previously uploaded
+        avatar image files behind in storage. Verify they get deleted.
+        """
+        hamlet = self.example_user("hamlet")
+        hamlet.avatar_source = UserProfile.AVATAR_FROM_USER
+        hamlet.save()
+
+        with get_test_image_file("img.png") as image_file:
+            upload_avatar_image(image_file, hamlet, content_type="image/png", future=False)
+
+        avatar_path_id = avatar_disk_path(hamlet)
+        avatar_original_path_id = avatar_disk_path(hamlet, original=True)
+        avatar_medium_path_id = avatar_disk_path(hamlet, medium=True)
+
+        self.assertTrue(os.path.isfile(avatar_path_id))
+        self.assertTrue(os.path.isfile(avatar_original_path_id))
+        self.assertTrue(os.path.isfile(avatar_medium_path_id))
+
+        do_delete_user(hamlet, acting_user=None)
+
+        self.assertFalse(os.path.isfile(avatar_path_id))
+        self.assertFalse(os.path.isfile(avatar_original_path_id))
+        self.assertFalse(os.path.isfile(avatar_medium_path_id))
