+    def test_do_delete_user_scrubs_pii(self) -> None:
+        """
+        do_delete_user_core overwrites the UserProfile row in place rather
+        than deleting it, so Django's CASCADE machinery never fires for
+        rows in other tables that reference the user. Verify that we
+        explicitly clean up tables that can carry personally identifying
+        information about the deleted user.
+        """
+        hamlet = self.example_user("hamlet")
+        hamlet_user_id = hamlet.id
+        realm = hamlet.realm
+
+        phone_field = CustomProfileField.objects.get(name="Phone number", realm=realm)
+        CustomProfileFieldValue.objects.create(
+            user_profile=hamlet, field=phone_field, value="+1-555-0100"
+        )
+        self.assertTrue(CustomProfileFieldValue.objects.filter(user_profile=hamlet).exists())
+
+        client = get_client("website")
+        do_update_user_status(
+            user_profile=hamlet,
+            away=None,
+            status_text="on vacation",
+            client_id=client.id,
+            emoji_name=None,
+            emoji_code=None,
+            reaction_type=None,
+        )
+        self.assertTrue(UserStatus.objects.filter(user_profile=hamlet).exists())
+
+        do_add_alert_words(hamlet, ["secretproject"])
+        self.assertTrue(AlertWord.objects.filter(user_profile=hamlet).exists())
+
+        PushDeviceToken.objects.create(user=hamlet, token="deadbeef", kind=PushDeviceToken.FCM)
+        self.assertTrue(PushDeviceToken.objects.filter(user=hamlet).exists())
+
+        Device.objects.create(user=hamlet)
+        self.assertTrue(Device.objects.filter(user=hamlet).exists())
+
+        EmailChangeStatus.objects.create(
+            new_email="hamlet-new@zulip.com",
+            old_email=hamlet.delivery_email,
+            user_profile=hamlet,
+            realm=realm,
+        )
+        self.assertTrue(EmailChangeStatus.objects.filter(user_profile=hamlet).exists())
+
+        do_delete_user(hamlet, acting_user=None)
+        hamlet.refresh_from_db()
+
+        self.assertFalse(
+            CustomProfileFieldValue.objects.filter(user_profile_id=hamlet_user_id).exists()
+        )
+        self.assertFalse(UserStatus.objects.filter(user_profile_id=hamlet_user_id).exists())
+        self.assertFalse(AlertWord.objects.filter(user_profile_id=hamlet_user_id).exists())
+        self.assertFalse(PushDeviceToken.objects.filter(user_id=hamlet_user_id).exists())
+        self.assertFalse(Device.objects.filter(user_id=hamlet_user_id).exists())
+        self.assertFalse(EmailChangeStatus.objects.filter(user_profile_id=hamlet_user_id).exists())
+
