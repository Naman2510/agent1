+run_test("handle_keydown ignores Cmd/Ctrl+Shift+bracket", ({override}) => {
+    // Cmd+Shift+]/[ are the browser's own "switch tab" shortcuts on
+    // macOS; some browsers still deliver the keydown to the page, and
+    // we must not treat that as our (unshifted) list indent/outdent
+    // shortcut. See #40112.
+    override(text_field_edit, "setFieldText", (elt, val) => {
+        elt.value = val;
+    });
+
+    navigator.platform = "MacIntel";
+    init_textarea_state("- Item 1|");
+
+    const event = {
+        key: "]",
+        shiftKey: true,
+        metaKey: true,
+        ctrlKey: false,
+        stopPropagation: noop,
+        preventDefault: noop,
+    };
+
+    compose_ui.handle_keydown(event, $textarea);
+    assert.equal(get_textarea_state(), "- Item 1|");
+
+    // Sanity check: the same combo without Shift is the real shortcut
+    // and does indent the list.
+    event.shiftKey = false;
+    compose_ui.handle_keydown(event, $textarea);
+    assert.equal(get_textarea_state(), "  - Item 1|");
+
+    navigator.platform = "";
+});
